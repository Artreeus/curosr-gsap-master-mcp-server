{
  "name": "cursor-gsap-master-mcp-server",
  "version": "1.0.0",
  "description": "A local MCP server for generating, explaining, debugging, and optimizing GSAP animations.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "gsap-master-mcp-server": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "echo 'Testing GSAP patterns...' && node -e 'console.log(\"All GSAP plugins now FREE!\")'"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "gsap",
    "greensock",
    "animation",
    "react",
    "vue",
    "nextjs",
    "scrolltrigger",
    "splittext",
    "drawsvg",
    "morphsvg",
    "draggable",
    "timeline",
    "performance",
    "60fps",
    "intent-analysis",
    "production-ready",
    "surgical-precision",
    "webflow-free",
    "ai",
    "claude",
    "cursor",
    "cursor-ide"
  ],
  "author": "Artreeus",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Artreeus/curosr-gsap-master-mcp-server"
  },
  "bugs": {
    "url": "https://github.com/Artreeus/curosr-gsap-master-mcp-server/issues"
  },
  "homepage": "https://github.com/Artreeus/curosr-gsap-master-mcp-server#readme"
}
